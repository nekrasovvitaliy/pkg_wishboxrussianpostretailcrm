<?xml version="1.0" encoding="UTF-8"?>
<project name="pkg_wishboxrussianpostretailcrm" default="make" basedir=".">
	<property name="package" value="pkg_wishboxrussianpostretailcrm.zip" />

	<target name="make" description="Build the Joomla package.">
		<delete quiet="yes">
			<fileset dir=".">
				<include name="${package}" />
			</fileset>
		</delete>

		<zip destfile="lib_wishboxrussianpostretailcrm.zip">
			<fileset dir="./lib_wishboxrussianpostretailcrm">
				<include name="language/**" />
				<include name="src/**" />
				<include name="lib_wishboxrussianpostretailcrm.xml" />
			</fileset>
		</zip>

		<zip destfile="com_wishboxrussianpostretailcrm.zip">
			<fileset dir="./com_wishboxrussianpostretailcrm">
				<include name="administrator/**" />
				<include name="api/**" />
				<include name="media/**" />
				<include name="wishboxrussianpostretailcrm.xml" />
			</fileset>
		</zip>

		<zip destfile="plg_task_wishboxrussianpostretailcrm.zip">
			<fileset dir="./plg_task_wishboxrussianpostretailcrm">
				<include name="forms/**" />
				<include name="language/**" />
				<include name="services/**" />
				<include name="src/**" />
				<include name="script.php" />
				<include name="wishboxrussianpostretailcrm.xml" />
			</fileset>
		</zip>

		<zip destfile="plg_webservices_wishboxrussianpostretailcrm.zip">
			<fileset dir="./plg_webservices_wishboxrussianpostretailcrm">
				<include name="language/**" />
				<include name="services/**" />
				<include name="src/**" />
				<include name="script.php" />
				<include name="wishboxrussianpostretailcrm.xml" />
			</fileset>
		</zip>

		<zip destfile="${package}">
			<fileset dir=".">
				<include name="com_wishboxrussianpostretailcrm.zip" />
				<include name="lib_wishboxrussianpostretailcrm.zip" />
				<include name="plg_task_wishboxrussianpostretailcrm.zip" />
				<include name="plg_webservices_wishboxrussianpostretailcrm.zip" />
				<include name="language/**" />
				<include name="script.php" />
				<include name="pkg_wishboxrussianpostretailcrm.xml" />
			</fileset>
		</zip>

		<delete quiet="yes">
			<fileset dir=".">
				<include name="com_wishboxrussianpostretailcrm.zip" />
				<include name="lib_wishboxrussianpostretailcrm.zip" />
				<include name="plg_task_wishboxrussianpostretailcrm.zip" />
				<include name="plg_webservices_wishboxrussianpostretailcrm.zip" />
			</fileset>
		</delete>
	</target>
</project>
