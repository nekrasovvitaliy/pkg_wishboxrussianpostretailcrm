			name="mail_category"
			type="text"
			label="COM_WISHBOXRUSSIANPOSTRETAILCRM_FIELD_MAIL_CATEGORY_LABEL"
			default="ORDINARY"
			required="true"
			filter="cmd"
		/>
		<field
			name="order_number_prefix"
			type="text"
			label="COM_WISHBOXRUSSIANPOSTRETAILCRM_FIELD_ORDER_NUMBER_PREFIX_LABEL"
			filter="string"
		/>
	</fieldset>
</config>
