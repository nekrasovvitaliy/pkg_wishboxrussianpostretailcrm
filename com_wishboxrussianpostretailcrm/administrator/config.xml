		<field
			name="mail_type"
			type="text"
			label="COM_WISHBOXRUSSIANPOSTRETAILCRM_FIELD_MAIL_TYPE_LABEL"
			default="ONLINE_PARCEL"
			required="true"
			filter="cmd"
		/>
